:80 {
  encode zstd gzip

  header {
    X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  }

  handle /robots.txt {
    header Content-Type "text/plain; charset=utf-8"
    respond "User-agent: *\nDisallow: /\n" 200
  }

  handle /_preview/* {
    reverse_proxy preview:8790
  }

  handle {
    forward_auth preview:8790 {
      uri /_preview/check
    }

    @api path /api/*
    reverse_proxy @api api:8787
    reverse_proxy web:3000
  }
}
