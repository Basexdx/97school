{
  "name": "genius-prototype-v16-multigrade",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "prepare:grade7": "node scripts/prepare-grade7-bank.mjs",
    "prepare:grade9": "node scripts/prepare-grade9-bank.mjs",
    "predev": "npm run bank:build",
    "dev": "concurrently -k -n API,WEB -c auto \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.jsonc --port 8787",
    "prebuild": "npm run bank:build",
    "build": "next build",
    "start": "next start",
    "db:local": "wrangler d1 execute DB --config wrangler.jsonc --local --file=cloudflare/schema.sql --yes",
    "setup:local": "node scripts/setup-local.mjs",
    "audit:clean": "npm audit --audit-level=high",
    "bank:build": "node scripts/prepare-grade7-bank.mjs && node scripts/prepare-grade9-bank.mjs && node scripts/build-task-bank.mjs",
    "db:tasks": "wrangler d1 execute DB --config wrangler.jsonc --local --file=cloudflare/task-bank.sql --yes",
    "test:bank": "npm run bank:build && node --test tests/task-checker.test.mjs tests/integration.test.mjs tests/academic.test.mjs tests/oge-bank.test.mjs tests/security.test.mjs && python3 tests/task-bank-sql.py",
    "start:web": "next start --hostname 127.0.0.1 --port 3000"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.5",
    "wrangler": "^4.42.0",
    "esbuild": "0.28.1"
  }
}
